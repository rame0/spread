		"db:push": "drizzle-kit push",
		"import:sqlite": "ts-node scripts/import-from-sqlite.ts",
		"categorize:reference": "ts-node scripts/build-reference-vectors.ts",
		"lint": "eslint src/**/*.ts",
		"format": "prettier --write src/**/*.ts"
	},
	"dependencies": {
		"@huggingface/tokenizers": "^0.2.0",
		"@types/uuid": "^10.0.0",
		"bcryptjs": "^2.4.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"drizzle-orm": "^0.45.2",
		"express": "^4.21.2",
		"express-rate-limit": "^8.3.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "2.3.0",
		"onnxruntime-node": "^1.30.0",
		"pdf-parse": "2.4.5",
		"pg": "^8.18.0",
		"pino": "^9.9.0",
		"pino-http": "^10.5.0",
		"uuid": "^11.1.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/bcryptjs": "^2.4.6",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.0",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.7",
		"@types/multer": "2.0.0",
		"@types/node": "^22.13.4",
		"@types/pg": "^8.16.0",
		"@typescript-eslint/eslint-plugin": "^5.62.0",
		"@typescript-eslint/parser": "^5.62.0",
		"drizzle-kit": "^0.31.8",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^8.10.0",
		"jest": "^29.7.0",
		"jest-environment-node": "^29.7.0",
		"nodemon": "^3.1.9",
		"prettier": "^2.8.8",
		"sql.js": "^1.14.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.3"
	},
	"engines": {
		"node": "22.3.0"
	},
