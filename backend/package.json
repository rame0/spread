{
	"name": "credit-grace-planner-backend",
	"version": "2.0.0",
	"description": "Backend for Credit Card Grace Planner (V2)",
	"main": "dist/index.js",
	"scripts": {
		"start": "node dist/index.js",
		"dev": "nodemon src/index.ts",
		"build": "tsc",
		"test": "jest",
