NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/credit_grace
JWT_SECRET=dev-only-local-secret
CORS_ORIGINS=http://localhost:3000,http://credit.local,https://credit.local
JSON_BODY_LIMIT=256kb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20
AUTH_COOKIE_NAME=grace_planner_auth
CSRF_COOKIE_NAME=grace_planner_csrf
AUTH_COOKIE_SECURE=auto
